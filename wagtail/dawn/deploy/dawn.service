[Unit]
Description=Gunicorn daemon for Dawn (Wagtail)
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/dawn
EnvironmentFile=/var/www/dawn/.env
ExecStart=/var/www/dawn/venv/bin/gunicorn \
    --workers 3 \
    --bind unix:/run/dawn/dawn.sock \
    --access-logfile /var/log/dawn/access.log \
    --error-logfile /var/log/dawn/error.log \
    --timeout 120 \
    dawn.wsgi:application
ExecReload=/bin/kill -s HUP $MAINPID
RuntimeDirectory=dawn
RuntimeDirectoryMode=0755
Restart=on-failure

[Install]
WantedBy=multi-user.target
