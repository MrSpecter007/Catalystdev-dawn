# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_SETTINGS_MODULE=dawn.settings.production

# Hosts — comma-separated, no spaces, no trailing slash
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
WAGTAILADMIN_BASE_URL=https://yourdomain.com

# Database (MySQL on Hostinger VPS)
DB_NAME=dawn_db
DB_USER=dawn_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=3306

# Email (optional — fill in for contact forms / password resets)
EMAIL_HOST=smtp.yourmailprovider.com
EMAIL_PORT=587
EMAIL_HOST_USER=you@yourdomain.com
EMAIL_HOST_PASSWORD=change-me
DEFAULT_FROM_EMAIL=you@yourdomain.com
