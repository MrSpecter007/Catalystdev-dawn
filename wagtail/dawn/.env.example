# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# Comma-separated — use VPS IP for now, add domain later
ALLOWED_HOSTS=2.25.147.203

# Set to true once HTTPS/domain is configured
HTTPS=false

# MySQL — must match docker-compose.prod.yml
DB_NAME=catalystdev
DB_USER=catalystdev
DB_HOST=db
DB_PORT=3306
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root

# Wagtail admin base URL
WAGTAILADMIN_BASE_URL=http://2.25.147.203

# Email (optional for now)
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=webmaster@catalystdv.com
